# ==============================================================================
# EduPulse ERP SaaS - Production AWS Cloud Environment Configuration
# ==============================================================================

# Spring Runtime Profile (prod enables PostgreSQL, S3, Hikari pooling, and JWT validation)
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 1. Database Configuration (AWS RDS PostgreSQL or Aurora Serverless)
# ------------------------------------------------------------------------------
# Example AWS RDS URL: jdbc:postgresql://edupulse-rds.xxxxxx.us-east-1.rds.amazonaws.com:5432/edupulse_erp
DATABASE_URL=jdbc:postgresql://postgres:5432/edupulse_erp
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=ReplaceWithStrongProductionPassword123!
DB_SSL_MODE=prefer
HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secret
# ------------------------------------------------------------------------------
# Minimum 256-bit hexadecimal or Base64 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------------------------------------------
# 3. AWS S3 Document Storage
# ------------------------------------------------------------------------------
APP_STORAGE_TYPE=s3
AWS_S3_BUCKET=edupulse-erp-production
AWS_REGION=us-east-1

# Optional if running inside AWS ECS / EC2 with an attached IAM Role / Task Role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# ------------------------------------------------------------------------------
# 4. Initial Bootstrap SuperAdmin (Creates administrator if missing)
# ------------------------------------------------------------------------------
BOOTSTRAP_SUPERADMIN_ENABLED=true
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@edupulse.org
BOOTSTRAP_SUPERADMIN_PASSWORD=Admin@123

# ------------------------------------------------------------------------------
# 5. Domain & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated allowed origins (supports web client and desktop app custom-protocol)
CORS_ALLOWED_ORIGINS=https://tauri.localhost,http://localhost:5173,http://localhost:80,https://app.edupulse.org

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (RBI Compliant Direct Settlement)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_live_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_live_webhook_secret

# ------------------------------------------------------------------------------
# 7. SaaS Integrations: Daily.co Video Classroom & Notion Notes Sync
# ------------------------------------------------------------------------------
DAILY_API_KEY=daily_api_key_placeholder
DAILY_DOMAIN=edupulse
NOTION_API_SECRET=your_notion_api_secret_here
NOTION_API_KEY=your_notion_api_key_here
NOTION_VERSION=2022-06-28
